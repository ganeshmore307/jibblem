# Public URL where this app is deployed, without a trailing slash.
# Example: https://your-domain.com
APP_URL=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional. When omitted, the app uses:
# ${APP_URL}/api/auth/google/callback
# If set, this value must exactly match an Authorized redirect URI in Google Cloud.
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback
